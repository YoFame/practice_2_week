<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Группа:"
        android:textStyle="bold" />
    <Spinner
        android:id="@+id/spGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnAddLesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Создать занятие"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Занятие:"
        android:textStyle="bold"
        android:layout_marginTop="12dp"/>
    <Spinner
        android:id="@+id/spLesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnDeleteLesson"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Удалить выбранное занятие"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Нет студентов или занятий."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMarks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="Присутствовали: 0 | Отсутствовали: 0 | Опоздали: 0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохранить отметки" />
</LinearLayout>